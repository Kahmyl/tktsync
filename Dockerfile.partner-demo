# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/partner-demo-web/package.json apps/partner-demo-web/package.json
RUN --mount=type=cache,id=tktsync-pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile
COPY apps/partner-demo-web apps/partner-demo-web
RUN pnpm --filter @tktsync/partner-demo-web build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /workspace/apps/partner-demo-web/dist ./dist
COPY apps/partner-demo-web/server.mjs ./server.mjs
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]
