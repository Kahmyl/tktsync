# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/tktsync-api ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && addgroup -S tktsync && adduser -S -G tktsync -u 10001 tktsync
COPY --from=build /out/tktsync-api /usr/local/bin/tktsync-api
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tktsync-api"]
