{
  "name": "tktsync",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "pnpm --filter @tktsync/api-client generate",
    "api:check": "pnpm --filter @tktsync/api-client check:generated",
    "api:routes": "node scripts/check-route-parity.mjs",
    "docs:generate": "node scripts/generate-partner-docs.mjs",
    "docs:check": "node scripts/generate-partner-docs.mjs --check",
    "compose:check": "node scripts/check-compose-config.mjs",
    "e2e": "playwright test",
    "demo:seed": "node scripts/seed-review-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
