FROM golang:1.25-alpine AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/tktsync-worker ./cmd/worker

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && addgroup -S tktsync && adduser -S -G tktsync -u 10001 tktsync
COPY --from=build /out/tktsync-worker /usr/local/bin/tktsync-worker
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/tktsync-worker"]
