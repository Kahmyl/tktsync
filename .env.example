APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_URL=postgres://tktsync:tktsync@localhost:5432/tktsync?sslmode=disable
POSTGRES_PORT=5432
LOG_LEVEL=info
LOG_FORMAT=json
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=example-anon-key
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
WORKER_POLL_INTERVAL=5s
WORKER_SHUTDOWN_TIMEOUT=10s
REALTIME_ENABLED=false
REALTIME_CHANNEL_PREFIX=tktsync
WEBHOOK_ENABLED=false
SELECTOR_BASE_URL=http://localhost:5174/s
BROWSER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=15s
HTTP_LONG_REQUEST_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_IN_FLIGHT=200
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

DB_TX_MAX_ATTEMPTS=3
DB_TX_RETRY_BASE_DELAY=10ms
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTION_LIFETIME=30m
DB_MAX_CONNECTION_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=3s

WORKER_CONCURRENCY=4
WORKER_RESERVATION_BATCH_SIZE=100
WORKER_OUTBOX_BATCH_SIZE=100
WORKER_WEBHOOK_BATCH_SIZE=50
WORKER_WEBHOOK_TIMEOUT=5s

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1

SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256

SELECTION_KEYRING_ACTIVE_VERSION=
SELECTION_KEYRING_KEYS=
RESERVATION_KEYRING_ACTIVE_VERSION=
RESERVATION_KEYRING_KEYS=
QR_KEYRING_ACTIVE_VERSION=
QR_KEYRING_KEYS=

WEBHOOK_ENCRYPTION_KEY_VERSION=
