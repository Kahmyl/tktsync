# Native API listen address. Compose keeps its API listener fixed at 0.0.0.0:8080.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
# Published host ports for the local Docker Compose stack.
POSTGRES_PORT=55439
API_HOST_PORT=58480
ADMIN_HOST_PORT=54470
SELECTOR_HOST_PORT=54471
SCANNER_HOST_PORT=54472
DOCS_HOST_PORT=54473
PARTNER_DEMO_HOST_PORT=54474
REVIEWER_HOST_PORT=54475

# Public deployment destinations used by the reviewer experience. Compose has
# usable local defaults; set every value to its HTTPS deployment URL in review.
# REVIEWER_PUBLIC_URL=https://review.example.com
# ADMIN_PUBLIC_URL=https://admin.example.com
# PARTNER_DEMO_PUBLIC_URL=https://tickets.example.com
# PARTNER_DEMO_RETURN_URL=https://tickets.example.com/checkout/return
# SELECTOR_PUBLIC_URL=https://selector.example.com
# SCANNER_PUBLIC_URL=https://scanner.example.com
# DOCS_PUBLIC_URL=https://docs.example.com
# API_PUBLIC_URL=https://api.example.com

# Server-only credential issued by the assessment demo seed. Never prefix this
# with VITE_ and never expose it through client-side deployment configuration.
PARTNER_DEMO_CREDENTIAL=
# Optional direct TLS for local acceptance. Normal deployments can terminate TLS
# at their reverse proxy and leave these unset.
PARTNER_DEMO_TLS_KEY=
PARTNER_DEMO_TLS_CERT=

# Optional limited review-account instructions rendered by the Reviewer Hub at
# build time. Prefer a temporary, assessment-only account with least privilege.
REVIEW_ACCESS_LABEL=
REVIEW_ACCESS_EMAIL=
REVIEW_ACCESS_PASSWORD=
REVIEW_ACCESS_INSTRUCTIONS=

# Optional display-only API environments for Partner docs. Local execution uses
# the fixed same-origin Compose proxy; production execution is always disabled.
DOCS_SANDBOX_API_BASE_URL=
DOCS_PRODUCTION_API_BASE_URL=

# Native host processes use this URL; Compose overrides it with postgres:5432.
DATABASE_URL=postgres://tktsync:tktsync@localhost:55439/tktsync?sslmode=disable
LOG_LEVEL=info
LOG_FORMAT=json
# Fill these public/client values to enable Admin and Scanner operator login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only Supabase secret key used to invite administrators. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
# Compose derives the local Admin invite redirect from ADMIN_HOST_PORT. Allow
# that URL under Supabase Auth -> URL Configuration -> Redirect URLs. Set an
# explicit ADMIN_INVITE_REDIRECT_URL only for a non-Compose deployment.
# ADMIN_INVITE_REDIRECT_URL=https://admin.example.com/set-password
SUPABASE_JWT_ISSUER=
WORKER_POLL_INTERVAL=5s
WORKER_SHUTDOWN_TIMEOUT=10s
REALTIME_MAX_CONNECTIONS=1000
REALTIME_ENABLED=false
REALTIME_CHANNEL_PREFIX=tktsync
WEBHOOK_ENABLED=false
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=15s
HTTP_LONG_REQUEST_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_IN_FLIGHT=200
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

DB_TX_MAX_ATTEMPTS=3
DB_TX_RETRY_BASE_DELAY=10ms
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTION_LIFETIME=30m
DB_MAX_CONNECTION_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=65s
DB_LOCK_TIMEOUT=3s

WORKER_RESERVATION_CONCURRENCY=2
WORKER_OUTBOX_CONCURRENCY=2
WORKER_WEBHOOK_CONCURRENCY=4
WORKER_RESERVATION_BATCH_SIZE=100
WORKER_OUTBOX_BATCH_SIZE=100
WORKER_WEBHOOK_BATCH_SIZE=50
WORKER_WEBHOOK_TIMEOUT=5s

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1

SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256

SELECTION_KEYRING_ACTIVE_VERSION=
SELECTION_KEYRING_KEYS=
RESERVATION_KEYRING_ACTIVE_VERSION=
RESERVATION_KEYRING_KEYS=
QR_KEYRING_ACTIVE_VERSION=
QR_KEYRING_KEYS=

WEBHOOK_ENCRYPTION_KEY_VERSION=
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEYRING=
PARTNER_CREDENTIAL_REPLAY_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BROWSER_TELEMETRY_ENDPOINT=

# Optional local application authorization for one Supabase Auth user.
# Supabase Dashboard: Authentication -> Users -> select user -> copy User ID.
# The User ID is the JWT sub, not an email, password, token, or key.
# false skips role creation; seeds never revoke an existing operator role.
LOCAL_OPERATOR_AUTH_SUBJECT=
LOCAL_OPERATOR_DISPLAY_NAME=Local Platform Admin
LOCAL_OPERATOR_PLATFORM_ADMIN=true
