APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_URL=postgres://tktsync:tktsync@localhost:5432/tktsync?sslmode=disable
POSTGRES_PORT=5432
LOG_LEVEL=info
LOG_FORMAT=json
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=example-anon-key
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
WORKER_POLL_INTERVAL=5s
WORKER_SHUTDOWN_TIMEOUT=10s
REALTIME_ENABLED=false
REALTIME_CHANNEL_PREFIX=tktsync
WEBHOOK_ENABLED=false
SHUTDOWN_TIMEOUT=10s

DB_TX_MAX_ATTEMPTS=3
DB_TX_RETRY_BASE_DELAY=10ms

SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256

SELECTION_KEYRING_ACTIVE_VERSION=
SELECTION_KEYRING_KEYS=
RESERVATION_KEYRING_ACTIVE_VERSION=
RESERVATION_KEYRING_KEYS=
QR_KEYRING_ACTIVE_VERSION=
QR_KEYRING_KEYS=

WEBHOOK_ENCRYPTION_KEY_VERSION=
WEBHOOK_ENCRYPTION_KEY=
PARTNER_CREDENTIAL_REPLAY_KEY=
